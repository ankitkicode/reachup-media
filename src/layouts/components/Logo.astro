---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

const { src }: { src?: string } = Astro.props;
const {
  logo,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;
---

<a href="/" class="navbar-brand inline-block">
  {
    src || logo ? (
      <>
        <ImageMod
          src={src ? src : logo}
          class={`inline-block `}
          width={logo_width.replace("px", "") * 2}
          height={logo_height.replace("px", "") * 2}
          alt={title}
          style={{
            height: logo_height.replace("px", "") + "px",
            width: logo_width.replace("px", "") + "px",
          }}
          format="webp"
        />
      </>
    ) : logo_text ? (
      <div class="flex flex-col items-start leading-none font-sans">
        <span class="text-3xl font-extrabold tracking-tight text-dark dark:text-white">
          Reach<span class="text-[#a4c639]">Up</span>
        </span>
        <span class="text-xs font-semibold tracking-[0.35em] text-gray-600 dark:text-gray-400 mt-1 uppercase">Media</span>
      </div>
    ) : (
      title
    )
  }
</a>
